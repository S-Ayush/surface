{
  "name": "@surface/sync-protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sync wire types and codecs (bootstrap frames, deltas, mutation batches).",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@surface/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server-paths": {
      "@surface/source": "./src/server-paths.ts",
      "types": "./dist/server-paths.d.ts",
      "default": "./dist/server-paths.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@surface/config": "workspace:*",
    "@types/node": "^24.19.2",
    "fast-check": "^4.10.2"
  }
}
