{
  "name": "@surface/editor",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Rich text editor (TipTap): the document schema (headless, also on the server) and the React editor.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./schema": {
      "@surface/source": "./src/schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:deep": "SURFACE_TEST_TIER=deep vitest run"
  },
  "dependencies": {
    "@surface/domain": "workspace:*",
    "@tiptap/core": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "emojibase-data": "18.0.0",
    "lowlight": "3.3.0",
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "@surface/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.7.2",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
