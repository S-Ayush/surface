{
  // Builds only the headless schema entry, for the server image (SPEC-013 §4.4 "Packaging"),
  // with Node module resolution. DOM *types* are here because TipTap's declarations need them
  // (parseHTML rules), so this build would accept a DOM global: ESLint's no-restricted-globals on
  // src/schema refuses them, and test/schema-node-env.test.ts runs the built entry with no DOM.
  // No Node types ("types": []), so a Node API in src/schema fails this build.
  "extends": "@surface/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "customConditions": [],
    "lib": ["ES2023", "DOM"],
    "types": []
  },
  "include": ["src/schema"],
  "exclude": ["src/**/*.test.ts"]
}
