{
  "extends": "@surface/config/tsconfig.web.json",
  "compilerOptions": {
    "noEmit": true,
    // Node types for the tests (node:crypto, dependency-cruiser's API). This config only
    // typechecks; the schema build (tsconfig.build.json) has no Node types, so a Node API in
    // src/schema fails there.
    "types": ["node"]
  },
  "include": ["src", "test", "stories"]
}
