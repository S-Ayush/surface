{
  "name": "@surface/domain",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Entity types, enums, invariants, filter engine, fractional indexing.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@surface/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "@surface/source": "./src/model/index.ts",
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:deep": "SURFACE_TEST_TIER=deep vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@surface/config": "workspace:*",
    "fast-check": "^4.10.2"
  }
}
