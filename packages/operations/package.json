{
  "name": "@surface/operations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Operation definitions shared by client and server (ADR-0011).",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@surface/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:deep": "SURFACE_TEST_TIER=deep vitest run",
    "registry:lint": "tsx --conditions=@surface/source scripts/registry.ts lint",
    "registry:snapshot": "tsx --conditions=@surface/source scripts/registry.ts snapshot"
  },
  "dependencies": {
    "@surface/domain": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@surface/config": "workspace:*",
    "tsx": "^4.23.15"
  }
}
