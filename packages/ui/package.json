{
  "name": "@surface/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system tokens and components.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
