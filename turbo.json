{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "passThroughEnv": ["SURFACE_VITEST_WORKERS"]
    },
    "test:int": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": ["SURFACE_VITEST_WORKERS", "TEST_DATABASE_URL"]
    },
    "test:deep": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": ["SURFACE_VITEST_WORKERS", "SURFACE_PROPERTY_SEED", "TEST_DATABASE_URL"]
    },
    "//#lint:deps": {
      "inputs": ["$TURBO_ROOT$/**", "!**/node_modules/**", "!**/dist/**", "!.claude/worktrees/**"]
    },
    "//#lint:css": {
      "inputs": ["$TURBO_ROOT$/**", "!**/node_modules/**", "!**/dist/**", "!.claude/worktrees/**"]
    },
    "//#format:check": {
      "inputs": ["$TURBO_ROOT$/**", "!**/node_modules/**", "!**/dist/**", "!.claude/worktrees/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
