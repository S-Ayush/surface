{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "passThroughEnv": ["SURFACE_VITEST_WORKERS"]
    },
    "test:int": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": ["SURFACE_VITEST_WORKERS", "TEST_DATABASE_URL"]
    },
    "test:deep": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": ["SURFACE_VITEST_WORKERS", "SURFACE_PROPERTY_SEED", "TEST_DATABASE_URL"]
    },
    "test:timing": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": ["SURFACE_VITEST_WORKERS", "TEST_DATABASE_URL"]
    },
    "//#lint:deps": {
      "inputs": [
        "$TURBO_ROOT$/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.turbo/**",
        "!.claude/worktrees/**"
      ]
    },
    "//#lint:css": {
      "inputs": [
        "$TURBO_ROOT$/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.turbo/**",
        "!.claude/worktrees/**"
      ]
    },
    "//#format:check": {
      "inputs": [
        "$TURBO_ROOT$/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.turbo/**",
        "!.claude/worktrees/**"
      ]
    },
    "//#licenses:check": {
      "inputs": [
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/scripts/check-licenses.mjs",
        "$TURBO_ROOT$/packages/config/licenses.js"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
