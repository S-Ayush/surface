{
  "name": "surface",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:db:down": "node scripts/dev.mjs db:down",
    "db:migrate": "node scripts/dev.mjs db:migrate",
    "build": "turbo run build",
    "lint": "turbo run lint lint:deps lint:css format:check",
    "lint:deps": "depcruise apps packages tests --config .dependency-cruiser.cjs",
    "typecheck": "turbo run typecheck",
    "test": "SURFACE_VITEST_WORKERS=1 turbo run test",
    "test:int": "SURFACE_VITEST_WORKERS=4 turbo run test:int",
    "test:deep": "node scripts/test-deep.mjs",
    "check": "SURFACE_VITEST_WORKERS=1 turbo run build lint lint:deps lint:css format:check licenses:check typecheck test",
    "check:fast": "SURFACE_VITEST_WORKERS=1 turbo run build lint typecheck test --affected && turbo run lint:deps lint:css format:check licenses:check",
    "sim": "pnpm --filter @surface/sync-sim sim",
    "sim:deep": "pnpm --filter @surface/sync-sim sim:deep",
    "registry:lint": "pnpm --filter @surface/operations registry:lint",
    "registry:snapshot": "pnpm --filter @surface/operations registry:snapshot && prettier --write packages/operations/catalog.snapshot.json",
    "format": "prettier --write . --cache --cache-strategy content --cache-location node_modules/.cache/prettier/.prettier-cache",
    "format:check": "prettier --check . --cache --cache-strategy content --cache-location node_modules/.cache/prettier/.prettier-cache",
    "changeset": "changeset",
    "docker:smoke": "scripts/docker-smoke.sh",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "licenses:check": "node scripts/check-licenses.mjs",
    "ui:tokens": "pnpm --filter @surface/ui tokens",
    "test:tokens": "pnpm --filter @surface/ui test:tokens",
    "storybook": "pnpm --filter @surface/ui storybook",
    "test:storybook": "pnpm --filter @surface/ui test:storybook",
    "test:visual": "pnpm --filter @surface/ui test:visual"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@surface/config": "workspace:*",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
