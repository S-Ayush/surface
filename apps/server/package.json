{
  "name": "@surface/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Surface server: HTTP API, sync hub, MCP, auth, jobs.",
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./testing": "./test/support/testing.ts"
  },
  "bin": {
    "surface": "./bin/surface.js"
  },
  "files": [
    "bin",
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --conditions=@surface/source --env-file=dev.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:deep": "SURFACE_TEST_TIER=deep vitest run && SURFACE_TEST_TIER=deep vitest run --config vitest.deep.config.js",
    "test:timing": "SURFACE_TEST_TIER=timing vitest run && SURFACE_TEST_TIER=timing vitest run --config vitest.deep.config.js",
    "test:int": "vitest run --config vitest.int.config.js",
    "db:generate": "drizzle-kit generate",
    "surface": "tsx --conditions=@surface/source --env-file-if-exists=dev.env src/cli/main.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@node-rs/argon2": "^2.2.2",
    "@surface/domain": "workspace:*",
    "@surface/editor": "workspace:*",
    "@surface/operations": "workspace:*",
    "@surface/sync-protocol": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@surface/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15"
  }
}
