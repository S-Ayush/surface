{
  "name": "@surface/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Surface server: HTTP API, sync hub, MCP, auth, jobs.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --conditions=@surface/source --env-file=dev.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@surface/domain": "workspace:*",
    "@surface/operations": "workspace:*",
    "@surface/sync-protocol": "workspace:*",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@surface/config": "workspace:*",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15"
  }
}
