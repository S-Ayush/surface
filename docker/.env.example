# Surface configuration (SPEC-004 §7). Copy this file to .env next to
# docker-compose.yml and fill in the three required values. Generate the secrets with:
#
#   openssl rand -hex 32    # SESSION_SECRET
#   openssl rand -hex 24    # POSTGRES_PASSWORD
#
# Compose expands `$` in this file: write a literal $ as $$. Hex values need nothing.
# Then run `docker compose up -d` and open the setup URL from `docker compose logs app`.
# Check the result at any time with: docker compose exec app surface doctor

# --- Required ----------------------------------------------------------------

# The address people type into the browser, without a path. Sign-in only works
# from exactly this origin. Use https:// behind a reverse proxy.
SURFACE_URL=https://surface.example.com

# At least 32 random bytes written as hex: openssl rand -hex 32
SESSION_SECRET=

# Password of the bundled PostgreSQL: openssl rand -hex 24
# Not needed when DATABASE_URL points at your own database.
POSTGRES_PASSWORD=

# --- Docker Compose ----------------------------------------------------------
# Read by docker compose, not by Surface.

# Use your own PostgreSQL: docker-compose.external-db.yml instead of docker-compose.yml.
# Add :docker-compose.override.yml when you use one (see docs/ops/reverse-proxy.md).
#COMPOSE_FILE=docker-compose.external-db.yml
# Image tag to run. Pin a version (e.g. 1.4.2) to control upgrades; see docs/ops/upgrade.md.
SURFACE_VERSION=latest
# Image repository, if you mirror it.
#SURFACE_IMAGE=ghcr.io/s-ayush/surface
# Host interface and port for Surface. Use 127.0.0.1 when a reverse proxy on the
# same host (such as the bundled Caddy) is the only way in.
SURFACE_BIND=0.0.0.0
SURFACE_PORT=3000

# --- Database ----------------------------------------------------------------

# Your own PostgreSQL 17+ instead of the bundled one (set COMPOSE_FILE above too).
# Most managed databases need ?sslmode=require. Default:
# postgres://surface:<POSTGRES_PASSWORD>@db:5432/surface
#DATABASE_URL=postgres://surface:password@db.internal:5432/surface?sslmode=require

# --- Email -------------------------------------------------------------------
# Without SMTP, Surface shows invite and password-reset links in the app instead.

# smtp://user:password@host:587 (STARTTLS) or smtps://user:password@host:465 (TLS)
#SMTP_URL=smtp://surface:password@mail.example.com:587
# Required with SMTP_URL.
#SMTP_FROM=Surface <surface@example.com>

# --- Optional ----------------------------------------------------------------

# Largest file upload, in MB (1-10240).
#UPLOAD_MAX_MB=25
# The MCP endpoint for AI clients (effective from M6).
#MCP_ENABLED=true
# A fixed first-run setup token (16+ characters). By default a random one is logged.
#SURFACE_SETUP_TOKEN=
# What this container runs: all, web (HTTP and sync only) or worker (background jobs only).
#SURFACE_ROLE=all
# fatal, error, warn, info, debug, trace or silent.
#LOG_LEVEL=info
# Expose Prometheus metrics at /metrics.
#METRICS_ENABLED=false
# Trust the one reverse proxy in front, when it connects from a private address: the client
# address is the last X-Forwarded-For entry. Set false if Surface is reachable without a proxy.
#TRUST_PROXY=true
# Automatic backups (effective from M7).
#BACKUP_SCHEDULE=
#BACKUP_RETENTION=

# --- Set by the image; rarely changed -----------------------------------------

# Listen address inside the container. Leave PORT alone: the compose files and
# Caddyfile expect 3000. To change the port on the host, set SURFACE_PORT instead.
#PORT=3000
#HOST=0.0.0.0
# Writable data volume (uploads, backups). Must be writable by uid 10001.
#DATA_DIR=/data
# Built web app inside the image.
#SURFACE_WEB_DIR=/app/web
# production, or development for local work.
#NODE_ENV=production
