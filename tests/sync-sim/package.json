{
  "name": "@surface/sync-sim",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Sync simulation: real sync-client stores against a server over a controllable network (PLAN-002 S9, ADR-0016).",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:deep": "SURFACE_TEST_TIER=deep vitest run",
    "test:int": "vitest run --config vitest.int.config.js",
    "sim": "node scripts/sim.mjs",
    "sim:deep": "node scripts/sim-deep.mjs"
  },
  "dependencies": {
    "@surface/domain": "workspace:*",
    "@surface/operations": "workspace:*",
    "@surface/sync-client": "workspace:*",
    "@surface/sync-protocol": "workspace:*"
  },
  "devDependencies": {
    "@surface/config": "workspace:*",
    "@surface/server": "workspace:*",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2"
  }
}
